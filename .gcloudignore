# Build-context exclusions for `gcloud run deploy --source`.
#
# IMPORTANT: gcloud only falls back to .gitignore when this file is ABSENT.
# The moment this file exists it is the ONLY list consulted, so every secret
# must be named here explicitly — do not assume .gitignore still applies.
# This repo holds live Stripe keys in .env; they must never reach the Cloud
# Build source tarball in GCS.

.git/
.gitignore

# Secrets — never ship these
.env
.env.*
!.env.example
service-account.json
*-sa-key.json
.gcp-sa-key.json
credentials.json
*.pem
*.key

# Local tooling / noise
.claude/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.log
.DS_Store

# Dead config kept pending deletion (Dockerfile no longer references it)
nginx.conf
