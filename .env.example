# SSA apex hub — environment reference. Real values are set on the Cloud Run
# service by deploy.sh (secrets via Secret Manager, never in this repo).

# ── Firebase (shared ssa-auth-71d16 project; client config, not secret) ──────
FIREBASE_PROJECT_ID=ssa-auth-71d16
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# The apex hosts its own OAuth handler (/__/auth/* proxy), so authDomain is
# the apex itself:
FIREBASE_AUTH_DOMAIN=sportsbookscienceanalytics.com

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_DOMAIN=.sportsbookscienceanalytics.com

# ── Firestore (entitlements live in the shared auth project) ─────────────────
FIRESTORE_PROJECT_ID=ssa-auth-71d16

# ── Stripe (Secret Manager in prod: stripe-secret-key / stripe-webhook-secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# TWO Stripe Price ids per catalog SKU: monthly, and the 6-month prepaid term.
# Each accepts a comma-separated list — first id serves new checkouts, the
# rest stay resolvable for existing subscribers after a repricing.
STRIPE_PRICE_SPORT_CFL=
STRIPE_PRICE_SPORT_CFL_6MO=
STRIPE_PRICE_SPORT_NCAAF=
STRIPE_PRICE_SPORT_NCAAF_6MO=
STRIPE_PRICE_SPORT_NFL=
STRIPE_PRICE_SPORT_NFL_6MO=
STRIPE_PRICE_SPORT_GOLF=
STRIPE_PRICE_SPORT_GOLF_6MO=
STRIPE_PRICE_BUNDLE_FOOTBALL=
STRIPE_PRICE_BUNDLE_FOOTBALL_6MO=
STRIPE_PRICE_ALL_ACCESS=
STRIPE_PRICE_ALL_ACCESS_6MO=
# Customer Portal configuration (bpc_…) minted by scripts/stripe_bootstrap_live:
# cancel at period end, no portal-side plan switches. Unset = account default.
STRIPE_PORTAL_CONFIG=

# Display amounts come from api/entitlements.py::LAUNCH_PRICE_CENTS (the
# decided 2026-08-08 ladder — also what the bootstrap scripts mint in Stripe).
# Override the DISPLAY only (e.g. mid-repricing) with:
# PRICE_DISPLAY_<SKU>=<cents>  /  PRICE_DISPLAY_<SKU>_6MO=<cents>

# ── URLs ─────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://sportsbookscienceanalytics.com

# ── Local dev only (NEVER on Cloud Run) ──────────────────────────────────────
# DISABLE_AUTH=1
# DEV_ENTITLEMENTS=cfl,golf
# Launch gate override: /pricing hides ALL amounts unless Stripe is configured
# OR this flag is set. Local exploration only — never set on the service.
# SHOW_PREVIEW_PRICES=1

# ── Local Stripe TEST drive (api/app.py auto-loads this .env) ────────────────
# 1. python3 -m pip install stripe python-dotenv
# 2. Stripe Dashboard → toggle Test mode → Developers → API keys → copy the
#    sk_test_… Secret key into STRIPE_SECRET_KEY above.
# 3. python3 -m scripts.stripe_bootstrap_test   (creates the 6 test products,
#    each with monthly + 6-month prices at the real launch amounts, and prints
#    the 12 STRIPE_PRICE_* lines to paste here)
# 4. Webhooks locally need the Stripe CLI:
#      brew install stripe/stripe-cli/stripe && stripe login
#      stripe listen --forward-to 127.0.0.1:8085/api/billing/webhook
#    → paste the printed whsec_… into STRIPE_WEBHOOK_SECRET above.
# 5. Checkout with test card 4242 4242 4242 4242, any future expiry/CVC.
