# SSA apex hub — environment reference. Real values are set on the Cloud Run
# service by deploy.sh (secrets via Secret Manager, never in this repo).

# ── Firebase (shared ssa-auth-71d16 project; client config, not secret) ──────
FIREBASE_PROJECT_ID=ssa-auth-71d16
FIREBASE_API_KEY=
FIREBASE_APP_ID=
# The apex hosts its own OAuth handler (/__/auth/* proxy), so authDomain is
# the apex itself:
FIREBASE_AUTH_DOMAIN=sportsbookscienceanalytics.com

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_COOKIE_DOMAIN=.sportsbookscienceanalytics.com

# ── Firestore (entitlements live in the shared auth project) ─────────────────
FIRESTORE_PROJECT_ID=ssa-auth-71d16

# ── Stripe (Secret Manager in prod: stripe-secret-key / stripe-webhook-secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One Stripe Price id per catalog SKU (monthly recurring prices):
STRIPE_PRICE_SPORT_CFL=
STRIPE_PRICE_SPORT_NCAAF=
STRIPE_PRICE_SPORT_NFL=
STRIPE_PRICE_SPORT_GOLF=
STRIPE_PRICE_BUNDLE_FOOTBALL=
STRIPE_PRICE_ALL_ACCESS=

# Display prices (cents/month) for the pricing page. Until set, sports show a
# $9.99 placeholder and bundle/all-access derive from the agreed rules
# (bundle = 20% off its parts, all-access = 50% off everything sellable).
# PRICE_DISPLAY_SPORT_CFL=999
# PRICE_DISPLAY_BUNDLE_FOOTBALL=1598
# PRICE_DISPLAY_ALL_ACCESS=1998

# ── URLs ─────────────────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://sportsbookscienceanalytics.com

# ── Local dev only (NEVER on Cloud Run) ──────────────────────────────────────
# DISABLE_AUTH=1
# DEV_ENTITLEMENTS=cfl,golf
